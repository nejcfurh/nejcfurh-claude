.DS_Store
*.bak.*
vendor/
settings.local.json
# Skills synced from the claude.ai org into ~/.claude/skills (a symlink to
# skills/) — managed by Claude Code, regenerated on sync, never committed.
skills/synced/
skills/.trash/
# Type contracts the plugin engine writes into a plugin folder when it loads
# it; regenerated per build, never committed.
plugins/*/.claude-plugin/types/
